<?xml version="1.0" encoding="utf-8"?>
<!-- canRetrieveWindowContent=false: o serviço recebe só o evento (ex.: rótulo do botão tocado),
     nunca a árvore de conteúdo da tela. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeViewClicked|typeNotificationStateChanged|typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:notificationTimeout="50"
    android:canRetrieveWindowContent="false"
    android:description="@string/a11y_desc" />
