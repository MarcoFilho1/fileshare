<?xml version="1.0" encoding="utf-8"?>
<!-- Resultado do pareamento pelo QR do Mac. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:gravity="center" android:orientation="vertical" android:padding="32dp">

    <FrameLayout android:id="@+id/badge" android:layout_width="104dp" android:layout_height="104dp"
        android:background="@drawable/bg_circle">
        <ImageView android:id="@+id/badge_icon" android:layout_width="56dp" android:layout_height="56dp"
            android:layout_gravity="center" android:importantForAccessibility="no" />
    </FrameLayout>

    <TextView android:id="@+id/title" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="28dp" android:gravity="center" android:textColor="@color/text"
        android:textSize="26sp" android:textStyle="bold" />
    <TextView android:id="@+id/text" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:maxWidth="420dp" android:gravity="center" android:lineSpacingExtra="4dp"
        android:textColor="@color/text_secondary" android:textSize="16sp" />

    <TextView android:id="@+id/next" android:layout_width="wrap_content" android:layout_height="48dp"
        android:layout_marginTop="36dp" android:gravity="center" android:minWidth="200dp"
        android:paddingStart="28dp" android:paddingEnd="28dp" android:background="@drawable/bg_pill"
        android:text="@string/action_continue" android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold" />
</LinearLayout>
