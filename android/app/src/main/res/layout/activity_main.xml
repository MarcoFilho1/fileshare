<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scroll" android:layout_width="match_parent" android:layout_height="match_parent"
    android:clipToPadding="false" android:fillViewport="true">

    <LinearLayout android:id="@+id/content" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal" android:orientation="vertical"
        android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingBottom="32dp">

        <!-- Cabeçalho -->
        <ImageView android:layout_width="96dp" android:layout_height="96dp" android:layout_gravity="center_horizontal"
            android:layout_marginTop="48dp" android:src="@mipmap/ic_launcher" android:importantForAccessibility="no" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal" android:layout_marginTop="16dp"
            android:text="FileShare" android:textColor="@color/text" android:textSize="32sp" android:textStyle="bold" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal" android:layout_marginTop="6dp" android:gravity="center"
            android:text="@string/tagline" android:textColor="@color/text_secondary" android:textSize="16sp" />

        <!-- Mac pareado e estado da conexão -->
        <LinearLayout style="@style/Card" android:layout_marginTop="32dp" android:padding="20dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical">
                <FrameLayout android:id="@+id/mac_icon_bg" android:layout_width="56dp" android:layout_height="56dp"
                    android:background="@drawable/bg_circle">
                    <ImageView android:layout_width="30dp" android:layout_height="30dp" android:layout_gravity="center"
                        android:src="@drawable/ic_laptop" android:importantForAccessibility="no" />
                </FrameLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:layout_marginStart="18dp" android:orientation="vertical">
                    <TextView android:id="@+id/mac_name" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textColor="@color/text" android:textSize="20sp" android:textStyle="bold" />
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="4dp" android:orientation="horizontal" android:gravity="center_vertical">
                        <View android:id="@+id/status_dot" android:layout_width="9dp" android:layout_height="9dp"
                            android:layout_marginEnd="8dp" android:background="@drawable/bg_circle" />
                        <TextView android:id="@+id/status" android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:textColor="@color/text_secondary" android:textSize="15sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <TextView android:id="@+id/pair_steps" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="18dp" android:lineSpacingExtra="6dp" android:text="@string/pair_steps"
                android:textColor="@color/text" android:textSize="15sp" android:visibility="gone" />

            <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="18dp"
                android:background="@color/divider" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="14dp" android:orientation="horizontal" android:gravity="center_vertical">
                <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/ic_lock"
                    android:tint="@color/text_secondary" android:importantForAccessibility="no" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="8dp" android:text="@string/encrypted"
                    android:textColor="@color/text_secondary" android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView style="@style/SectionTitle" android:text="@string/section_setup" />
        <LinearLayout android:id="@+id/setup" style="@style/Card" />

        <TextView style="@style/SectionTitle" android:text="@string/section_howto" />
        <LinearLayout android:id="@+id/howto" style="@style/Card" />

        <TextView android:id="@+id/forget" android:layout_width="wrap_content" android:layout_height="44dp"
            android:layout_gravity="center_horizontal" android:layout_marginTop="28dp" android:gravity="center"
            android:paddingStart="20dp" android:paddingEnd="20dp" android:background="@drawable/bg_pill_soft"
            android:text="@string/forget_mac" android:textColor="@color/brand" android:textSize="15sp" android:textStyle="bold" />
        <TextView android:id="@+id/footer" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal" android:layout_marginTop="16dp"
            android:textColor="@color/text_secondary" android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
